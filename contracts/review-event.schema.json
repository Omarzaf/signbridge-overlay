{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signbridge.example/contracts/review-event.schema.json",
  "$comment": "Structural validation only; this schema cannot authorize release or establish claim truth.",
  "title": "SignBridge Review Event",
  "description": "Append-only proposal or human-review decision tied to an exact segment decision hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "sequence",
    "occurredAt",
    "environment",
    "packId",
    "segmentId",
    "decisionHash",
    "actor",
    "action",
    "translationStatus",
    "reviewStatus",
    "assetIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "$ref": "#/$defs/eventId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "environment": {
      "enum": ["synthetic_test", "development", "production"]
    },
    "packId": {
      "$ref": "#/$defs/packId"
    },
    "segmentId": {
      "$ref": "#/$defs/segmentId"
    },
    "decisionHash": {
      "$ref": "#/$defs/hash"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actorRef"],
      "properties": {
        "kind": {
          "enum": ["authoring_service", "human_reviewer"]
        },
        "actorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "authoring_service"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "actorRef": {
                "pattern": "^service_[a-z0-9]{12,64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human_reviewer"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "actorRef": {
                "pattern": "^reviewer_[a-z0-9]{12,64}$"
              }
            }
          }
        }
      ]
    },
    "action": {
      "enum": [
        "proposal_created",
        "approved",
        "unsupported_confirmed",
        "changes_requested",
        "rejected"
      ]
    },
    "translationStatus": {
      "enum": ["proposed", "mapped", "unsupported"]
    },
    "reviewStatus": {
      "enum": ["pending", "approved", "changes_requested", "rejected"]
    },
    "assetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetId"
      }
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "authoring_service"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "action": {
            "const": "proposal_created"
          },
          "reviewStatus": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "proposal_created"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "authoring_service"
              }
            }
          },
          "reviewStatus": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approved"
          }
        },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "human_reviewer"
              }
            }
          },
          "translationStatus": {
            "const": "mapped"
          },
          "reviewStatus": {
            "const": "approved"
          },
          "assetIds": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "unsupported_confirmed"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["reasonCode"],
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "human_reviewer"
              }
            }
          },
          "translationStatus": {
            "const": "unsupported"
          },
          "reviewStatus": {
            "const": "approved"
          },
          "assetIds": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "changes_requested"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["reasonCode"],
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "human_reviewer"
              }
            }
          },
          "reviewStatus": {
            "const": "changes_requested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rejected"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["reasonCode"],
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "human_reviewer"
              }
            }
          },
          "reviewStatus": {
            "const": "rejected"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packId": {
      "type": "string",
      "pattern": "^spk_[a-z0-9]{12,64}$"
    },
    "segmentId": {
      "type": "string",
      "pattern": "^seg_[a-z0-9]{12,64}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^ast_[a-z0-9]{12,64}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^rev_[a-z0-9]{12,64}$"
    }
  }
}
