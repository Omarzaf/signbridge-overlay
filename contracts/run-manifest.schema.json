{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signbridge.example/contracts/run-manifest.schema.json",
  "title": "SignBridge Authoring Run Manifest",
  "description": "Privacy-minimized reproducibility metadata for a proposal run; it conveys no review or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "environment",
    "startedAt",
    "completedAt",
    "status",
    "tool",
    "input",
    "output",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9]{12,64}$"
    },
    "environment": {
      "enum": ["synthetic_test", "development", "production"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["succeeded", "failed"]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": {
          "enum": ["google"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timedTextHash",
        "segmentCount",
        "signedLanguage",
        "region"
      ],
      "properties": {
        "timedTextHash": {
          "$ref": "#/$defs/hash"
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 1
        },
        "signedLanguage": {
          "type": "string",
          "pattern": "^[a-z]{3}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalLogHash", "reviewEventIds"],
      "properties": {
        "proposalLogHash": {
          "$ref": "#/$defs/hash"
        },
        "reviewEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rev_[a-z0-9]{12,64}$"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsTranscript",
        "containsIdentity",
        "containsMediaUrl"
      ],
      "properties": {
        "containsTranscript": {
          "const": false
        },
        "containsIdentity": {
          "const": false
        },
        "containsMediaUrl": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
