{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signbridge.example/contracts/asset-ledger.schema.json",
  "$comment": "Structural validation only; this schema cannot authorize release or establish claim truth.",
  "title": "SignBridge Asset Ledger",
  "description": "Rights, consent, review, and withdrawal evidence for exact signing-media hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerId",
    "packId",
    "generatedAt",
    "developmentOnly",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "ledgerId": {
      "type": "string",
      "pattern": "^ledger_[a-z0-9]{12,64}$"
    },
    "packId": {
      "type": "string",
      "pattern": "^spk_[a-z0-9]{12,64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "developmentOnly": {
      "type": "boolean"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRecord"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^ast_[a-z0-9]{12,64}$"
    },
    "assetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "path",
        "sha256",
        "ownerRef",
        "sourceRef",
        "signerRefs",
        "assetStatus",
        "reviewStatus",
        "consent",
        "rights",
        "attribution"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/assetId"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "ownerRef": {
          "type": "string",
          "pattern": "^owner_[a-z0-9]{12,64}$"
        },
        "sourceRef": {
          "type": "string",
          "pattern": "^source_[a-z0-9]{12,64}$"
        },
        "signerRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^signer_[a-z0-9]{12,64}$"
          }
        },
        "assetStatus": {
          "enum": ["draft", "licensed", "withdrawn"]
        },
        "reviewStatus": {
          "enum": ["pending", "approved", "changes_requested", "rejected"]
        },
        "consent": {
          "$ref": "#/$defs/consent"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "attribution": {
          "type": "string",
          "maxLength": 240
        },
        "reviewerApproval": {
          "$ref": "#/$defs/reviewerApproval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assetStatus": {
                "const": "licensed"
              }
            },
            "required": ["assetStatus"]
          },
          "then": {
            "required": ["reviewerApproval"],
            "properties": {
              "signerRefs": {
                "minItems": 1
              },
              "reviewStatus": {
                "const": "approved"
              },
              "consent": {
                "required": ["consentRef", "subjectSignerRefs", "exactHash"],
                "properties": {
                  "status": {
                    "const": "granted"
                  },
                  "subjectSignerRefs": {
                    "minItems": 1
                  }
                }
              },
              "rights": {
                "required": [
                  "grantRef",
                  "exactHash",
                  "termModel",
                  "grantedPurposes",
                  "grantedChannels",
                  "territories"
                ],
                "properties": {
                  "grantedPurposes": {
                    "minItems": 1
                  },
                  "grantedChannels": {
                    "minItems": 1
                  },
                  "territories": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "subjectSignerRefs"],
      "properties": {
        "status": {
          "enum": ["pending", "granted", "withdrawn"]
        },
        "consentRef": {
          "type": "string",
          "pattern": "^consent_[a-z0-9]{12,64}$"
        },
        "subjectSignerRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^signer_[a-z0-9]{12,64}$"
          }
        },
        "exactHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantedPurposes",
        "grantedChannels",
        "territories",
        "modification",
        "hosting",
        "redistribution",
        "sublicensing"
      ],
      "properties": {
        "grantRef": {
          "type": "string",
          "pattern": "^rights_[a-z0-9]{12,64}$"
        },
        "exactHash": {
          "$ref": "#/$defs/hash"
        },
        "termModel": {
          "const": "irrevocable_exact_hash"
        },
        "grantedPurposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "product_playback",
              "public_demo",
              "contest_submission",
              "sponsor_publicity"
            ]
          }
        },
        "grantedChannels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pwa",
              "chrome_extension",
              "offline_signpack",
              "demo_video",
              "contest_platform",
              "sponsor_media"
            ]
          }
        },
        "modification": {
          "type": "boolean"
        },
        "hosting": {
          "type": "boolean"
        },
        "redistribution": {
          "type": "boolean"
        },
        "sublicensing": {
          "type": "boolean"
        },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "const": "worldwide"
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            ]
          }
        }
      }
    },
    "reviewerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerRef", "eventId", "approvedHash"],
      "properties": {
        "reviewerRef": {
          "type": "string",
          "pattern": "^reviewer_[a-z0-9]{12,64}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^rev_[a-z0-9]{12,64}$"
        },
        "approvedHash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
